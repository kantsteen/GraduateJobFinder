@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<form method="get" class="d-flex gap-2 mb-2">
     <!--Sort by date button-->
    <button type="submit"
            name="sortOrder"
            value="@Model.NextDateSort"
            class="btn btn-primary">
        @(Model.NextDateSort == "date_asc"
            ? "Vis ældste først"
            : "Vis nyeste først")
    </button>    

    <!--Programming language filter dropdown-->
    <div class="dropdown">
        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown"
                data-bs-auto-close="outside">
            Programmeringssprog
        </button>

        <div class="dropdown-menu p-3">
            @foreach (var language in Model.ProgLangList)
            {
                <div class="form-check">
                    <input class="form-check-input" 
                           type="checkbox" 
                           name="programmingLanguages" 
                           value="@language"
                           id="@language"
                           checked="@(Model.LanguageFilter != null && Model.LanguageFilter.Contains(language))" 
                           onchange="this.form.requestSubmit(document.getElementById('applyFilters'))"/>
                    <label class="form-check-label" for="@language">
                        @language
                    </label>
                </div>
            }
        </div>
    </div>
</form>



@foreach (var jobPosting in Model.JobPostings)
{
    <partial name="_jobPosting" model="jobPosting" />
}

