@model GraduateJobFinder.Models.JobPosting
    
<div class="cards">
  <article class="card">
    <header>
      <h2><a href="@Model.URL" target="_blank">@Model.Title</a></h2>
    </header>
    <div class="content">
      <p>
        @Model.CompanyName
      </p>
      <p>
       @Model.Description
      </p>
      <p>
        @Model.Location
      </p>
      <p>
        @Model.Date
      </p>
      <p>
        @Model.URL
      </p>
  </article>
</div>