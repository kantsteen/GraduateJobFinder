@page
@model GraduateJobFinder.Pages_Postings.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>JobPosting</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="JobPosting.Id" />
            <div class="form-group">
                <label asp-for="JobPosting.CompanyName" class="control-label"></label>
                <input asp-for="JobPosting.CompanyName" class="form-control" />
                <span asp-validation-for="JobPosting.CompanyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobPosting.Title" class="control-label"></label>
                <input asp-for="JobPosting.Title" class="form-control" />
                <span asp-validation-for="JobPosting.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobPosting.Description" class="control-label"></label>
                <input asp-for="JobPosting.Description" class="form-control" />
                <span asp-validation-for="JobPosting.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobPosting.Location" class="control-label"></label>
                <input asp-for="JobPosting.Location" class="form-control" />
                <span asp-validation-for="JobPosting.Location" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobPosting.Date" class="control-label"></label>
                <input asp-for="JobPosting.Date" class="form-control" />
                <span asp-validation-for="JobPosting.Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobPosting.URL" class="control-label"></label>
                <input asp-for="JobPosting.URL" class="form-control" />
                <span asp-validation-for="JobPosting.URL" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LanguageName" class="control-label"></label>
                <input asp-for="LanguageName" list="language-options" class="form-control" />
                <datalist id="language-options">
                    @foreach (var LanguageName in Model.AllProgrammingLanguageNames)
                    {
                        <option value="@LanguageName"></option>
                    }
                </datalist>

                @foreach (var programmingLanguage in Model.JobPosting.ProgrammingLanguages)
                {
                    <span class="badge text-bg-light border d-inline-flex align-items-center fs-6 me-1 mt-2">
                        @programmingLanguage.Name
                        <button type="submit"
                                asp-page-handler="RemoveLanguage"
                                asp-route-languageToRemove="@programmingLanguage.Name"
                                formnovalidate
                                class="btn-close" aria-label="Remove @programmingLanguage.Name"></button>
                    </span> 
                }
                <span asp-validation-for="LanguageName" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
